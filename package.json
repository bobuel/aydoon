{
  "name": "alex-aidun---ai-product-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build && node scripts/prepare-static-routes.mjs",
    "build:pages": "vite build --mode pages && node scripts/prepare-static-routes.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 8080",
    "preview:pages": "vite preview --mode pages --host 127.0.0.1 --port 8080",
    "check": "npm run typecheck && npm test && npm run build",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.11"
  }
}
